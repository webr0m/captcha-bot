{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "captcha-bot",
  "compatibility_date": "2025-09-01",
  "main": "src/index.ts",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
